{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "declaration": true,
    "outDir": "lib",
    "target": "es2022",
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "rootDir": "./src/",
    "sourceMap": true,
    "newLine": "lf"
  },
  "exclude": ["test", "lib", "node_modules"]
}
